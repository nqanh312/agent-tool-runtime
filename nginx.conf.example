worker_processes auto;

events {
    worker_connections 1024;
}

http {
    # This protects the application before authentication. The app separately
    # enforces per-user limits and a daily estimated-token quota.
    limit_req_zone $binary_remote_addr zone=chat_per_ip:10m rate=10r/m;

    upstream assignment_1_app {
        server 127.0.0.1:9004;
        keepalive 16;
    }

    server {
        listen 80;
        server_name _;

        # Keep this aligned with MAX_REQUEST_BODY_BYTES (65536 bytes by default).
        client_max_body_size 64k;

        location = /api/chat {
            limit_req zone=chat_per_ip burst=5 nodelay;
            proxy_pass http://assignment_1_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }

        location / {
            proxy_pass http://assignment_1_app;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
        }
    }
}
