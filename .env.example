# Select one chat-model provider: anthropic, openai, or fci.
LLM_PROVIDER=anthropic

# Optional shared model override. Leave empty to use the provider-specific model.
LLM_MODEL=

# Anthropic chat model
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI chat model (and embeddings when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key
OPENAI_LLM_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# FCI/FPT Cloud OpenAI-compatible chat and embedding models
FCI_API_KEY=your_fci_api_key
FCI_MODEL=gemma-4-31B-it
FCI_BASE_URL=https://mkp-api.fptcloud.com/v1
MEMORY_EXTRACTION_MODEL=gemma-4-31B-it
TURN_PLANNER_MODEL=gemma-4-31B-it
MEMORY_EXTRACTION_MIN_CONFIDENCE=0.7
MEMORY_RELEVANCE_MIN_SEMANTIC_SCORE=0.7

# Embeddings can use OpenAI or the FCI OpenAI-compatible endpoint.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
# FCI example:
# EMBEDDING_PROVIDER=fci
# EMBEDDING_MODEL=multilingual-e5-large
# EMBEDDING_DIM=1024
# MEMORY_COLLECTION=agent_memory_fci_1024
MEMORY_CHUNK_TOKENS=500
MEMORY_CHUNK_OVERLAP_TOKENS=75

# Google Drive
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_URL=
QDRANT_API_KEY=
MEMORY_COLLECTION=agent_memory

# Durable chat history (PostgreSQL)
DATABASE_URL=postgresql+psycopg://agent:agent@localhost:5432/agent_db
CHAT_CONTEXT_MAX_TOKENS=12000
SERVICE_API_KEY=sk-admin-001
