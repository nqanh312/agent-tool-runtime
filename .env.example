# Select one chat-model provider: anthropic, openai, or fci.
LLM_PROVIDER=anthropic

# Optional shared model override. Leave empty to use the provider-specific model.
LLM_MODEL=

# Anthropic chat model
ANTHROPIC_API_KEY=your_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# OpenAI chat model and embeddings
OPENAI_API_KEY=your_openai_api_key
OPENAI_LLM_MODEL=gpt-4.1-mini
# OPENAI_BASE_URL=

# FCI/FPT Cloud OpenAI-compatible chat model
FCI_API_KEY=your_fci_api_key
FCI_MODEL=gemma-4-31B-it
FCI_BASE_URL=https://mkp-api.fptcloud.com/v1

# Embeddings remain OpenAI-backed for RAG, regardless of LLM_PROVIDER.
EMBEDDING_MODEL=text-embedding-3-small

# Google Drive
GOOGLE_SERVICE_ACCOUNT_FILE=credentials.json
GOOGLE_DRIVE_FOLDER_ID=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
